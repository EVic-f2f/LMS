# 1. Core Supabase Client API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_STORAGE_BUCKET=classwork-files
SESSION_SECRET=replace-with-at-least-32-random-bytes

# 2. Admin/Server Secret (Optional - Use only for backend tasks)
SUPABASE_SERVICE_ROLE_KEY=your-super-secret-service-role-key
# Required by the private Supabase Storage API; keep it server-side only.

# 3. Connection String (Optional - Required only if using Prisma/Drizzle/Knex ORMs)
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres
